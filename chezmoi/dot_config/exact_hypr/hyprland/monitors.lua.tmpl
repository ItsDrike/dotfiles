{{- if eq .chezmoi.hostname "orca" }}
-- Built-in laptop panel
hl.monitor({ output = "eDP-1", mode = "2560x1600@240", position = "0x0", scale = 1.25 })

-- Home monitors
hl.monitor({ output = "desc:Microstep MSI MAG 256F BC1H174600235", mode = "1920x1080@180", position = "2048x0", scale = 1 }) -- right
hl.monitor({ output = "desc:AOC 2260WG5 KBEH81A000795", mode = "1920x1080@60", position = "2048x1200", scale = 1 }) -- right

-- Default rule: mirror unspecified/unrecognized external monitors with the laptop panel
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1, mirror = "eDP-1" })
{{- else }}
{{ fail (printf "No Hyprland monitor configuration defined for host %q" .chezmoi.hostname) }}
{{- end }}
