{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl delete *", "effect": "ask" },
    { "action": "shell", "resource": "terraform destroy *", "effect": "ask" },
    { "action": "shell", "resource": "pass *", "effect": "ask" },
    { "action": "external_directory", "resource": "$HOME/.local/share/pass/*", "effect": "ask" },
    { "action": "read", "resource": "$HOME/.local/share/pass/*", "effect": "ask" },
    { "action": "edit", "resource": "$HOME/.local/share/pass/*", "effect": "ask" },
    { "action": "external_directory", "resource": "$HOME/.local/share/git/credentials/*", "effect": "ask" },
    { "action": "read", "resource": "$HOME/.local/share/git/credentials/*", "effect": "ask" },
    { "action": "edit", "resource": "$HOME/.local/share/git/credentials/*", "effect": "ask" }
  ],
  "providers": {
    "cli-proxy-api": {
      "name": "CLI Proxy API",
      "env": [
        "CLIPROXY_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://ai.home.arpa/v1",
      },
      "models": {
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol (Proxy)",
          "package": "@opencode/ai/providers/openai"
        },
        "gpt-6-luna": {
          "name": "GPT-6 Luna (Proxy)",
          "package": "@opencode/ai/providers/openai"
        },
        "gpt-6.1-terra": {
          "name": "GPT-6.1 Terra (Proxy)",
          "package": "@opencode/ai/providers/openai"
        },
        "gpt-5.5": {
          "name": "GPT-5.5 (Proxy)",
          "package": "@opencode/ai/providers/openai"
        },

        "personal/gpt-6.1-sol": {
          "name": "GPT-6.1 Sol (Personal)",
          "package": "@opencode/ai/providers/openai"
        },
        "personal/gpt-6-luna": {
          "name": "GPT-6 Luna (Personal)",
          "package": "@opencode/ai/providers/openai"
        },
        "personal/gpt-6.1-terra": {
          "name": "GPT-6.1 Terra (Personal)",
          "package": "@opencode/ai/providers/openai"
        },
        "personal/gpt-5.5": {
          "name": "GPT-5.5 (Personal)",
          "package": "@opencode/ai/providers/openai"
        },

        "work/gpt-6.1-sol": {
          "name": "GPT-6.1 Sol (Work)",
          "package": "@opencode/ai/providers/openai"
        },
        "work/gpt-6-luna": {
          "name": "GPT-6 Luna (Work)",
          "package": "@opencode/ai/providers/openai"
        },
        "work/gpt-6.1-terra": {
          "name": "GPT-6.1 Terra (Work)",
          "package": "@opencode/ai/providers/openai"
        },
        "work/gpt-5.5": {
          "name": "GPT-5.5 (Work)",
          "package": "@opencode/ai/providers/openai"
        },

        "deepseek-flash": {
          "name": "DeepSeek Flash (Proxy)",
          "package": "@opencode/ai/providers/openai-compatible"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (Proxy)",
          "package": "@opencode/ai/providers/openai-compatible"
        },

        "claude-haiku-4-5-20251001": {
          "name": "Claude Haiku 4.5 (Proxy)",
          "package": "@opencode/ai/providers/anthropic"
        },
        "claude-sonnet-5-5": {
          "name": "Claude Sonnet 5.5 (Proxy)",
          "package": "@opencode/ai/providers/anthropic"
        },
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5 (Proxy)",
          "package": "@opencode/ai/providers/anthropic"
        },
        "claude-fable-5-1": {
          "name": "Claude Fable 5.1 (Proxy)",
          "package": "@opencode/ai/providers/anthropic"
        }
      }
    }
  }
}
