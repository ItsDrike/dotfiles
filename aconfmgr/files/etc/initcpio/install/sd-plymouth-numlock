#!/usr/bin/env bash

build() {
    add_systemd_unit initrd-plymouth-numlock.service
    add_binary /usr/bin/evemu-event
    add_file /usr/lib/initcpio/plymouth-numlock-toggle /usr/lib/initcpio/plymouth-numlock-toggle 755
    add_symlink \
        /usr/lib/systemd/system/initrd.target.wants/initrd-plymouth-numlock.service \
        /usr/lib/systemd/system/initrd-plymouth-numlock.service
}

help() {
    printf '%s\n' 'Inject a NumLock key event after Plymouth starts, enabling NumLock in its internal keyboard state.'
}
