#!/usr/bin/env bash

build() {
    add_systemd_unit initrd-numlock.service
    add_symlink \
        /usr/lib/systemd/system/initrd.target.wants/initrd-numlock.service \
        /usr/lib/systemd/system/initrd-numlock.service
}

help() {
    printf '%s\n' 'Enable numlock after console setup and before the LUKS password / TPM pin prompt.'
}
