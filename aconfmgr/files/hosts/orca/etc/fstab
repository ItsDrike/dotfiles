LABEL=FS 		/         	btrfs     	rw,noatime,lazytime,compress=zstd:1,ssd,space_cache=v2,subvol=/@bootstrap-root	0 0

# /dev/mapper/cryptfs LABEL=FS UUID=1e234f6f-db0c-47f6-91ab-0210447d5ef7	
