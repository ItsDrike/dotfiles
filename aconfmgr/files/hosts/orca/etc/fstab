# /dev/mapper/cryptfs LABEL=FS UUID=1e234f6f-db0c-47f6-91ab-0210447d5ef7	
LABEL=FS 		/data     	btrfs     	rw,noatime,lazytime,compress=zstd:1,ssd,space_cache=v2,subvol=/@data	0 0

# /dev/mapper/cryptfs LABEL=FS UUID=1e234f6f-db0c-47f6-91ab-0210447d5ef7	
LABEL=FS 		/swap     	btrfs     	rw,noatime,lazytime,compress=zstd:1,ssd,space_cache=v2,subvol=/@swap	0 0

# /dev/mapper/cryptfs LABEL=FS UUID=1e234f6f-db0c-47f6-91ab-0210447d5ef7	
LABEL=FS 		/.btrfs   	btrfs     	rw,noatime,lazytime,compress=zstd:1,ssd,space_cache=v2,subvol=/	0 0

# /dev/nvme0n1p1 LABEL=EFI UUID=DECC-CE58      	
LABEL=EFI 		/efi      	vfat      	rw,relatime,fmask=0077,dmask=0077,codepage=437,iocharset=ascii,shortname=mixed,utf8,errors=remount-ro	0 2

/swap/swapfile      	none      	swap      	defaults  	0 0

